FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps . \
    && pip install --no-cache-dir "httpx>=0.27" "pydantic>=2.7" "pydantic-settings>=2.4" "slack_bolt>=1.21" "aiohttp>=3.9"

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN mkdir -p /data && chown 10001 /data
USER 10001

CMD ["python", "-m", "chat_gateway"]
