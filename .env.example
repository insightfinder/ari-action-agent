# --- Temporal (hosted externally — this service is only a client/worker) ---
TEMPORAL_HOST=temporal.internal.example.com:7233
TEMPORAL_NAMESPACE=oncall-ari-agent
TEMPORAL_TASK_QUEUE=oncall-ari-fix-queue
TEMPORAL_TLS_ENABLED=true
# Set only if the namespace uses Temporal Cloud API-key auth; leave blank for mTLS-only.
TEMPORAL_API_KEY=

# --- Inbound auth for this agent's own API ---
# Comma-separated list of API keys this service will accept on the
# `x-api-key` header. Callers get one of these out of band.
AGENT_API_KEYS=change-me-dev-key

# Public base URL this agent is reachable at (used in the Agent Card).
AGENT_PUBLIC_URL=https://ari-oncall-agent.internal.example.com

# --- Sandbox ---
# Root directory where each request's ephemeral clone/workspace is created
# and torn down. Must be writable and have enough disk for repo clones.
SANDBOX_ROOT=/var/lib/ari-agent/sandbox

# --- Repo cache ---
# Root directory for the per-worker local mirror cache (see
# tools/repo_cache.py) that lets multiple requests against the same repo
# share one fetched-and-kept-current mirror instead of each doing a full
# clone from the remote. Persists across requests — do NOT point this at
# SANDBOX_ROOT or anything cleaned up per-request. Multiple worker
# replicas each keep their own independent cache unless this path is a
# shared volume (e.g. NFS/EFS) mounted at the same path on every replica.
REPO_CACHE_ROOT=/var/lib/ari-agent/repo-cache

# --- opencode ---
# Path to the opencode binary/entrypoint used by the analyze/generate_fix/verify capabilities.
OPENCODE_BIN=opencode

# --- GitHub MCP (public hosted server used for PR operations) ---
GITHUB_MCP_SERVER_URL=https://api.githubcopilot.com/mcp/

LOG_LEVEL=info
