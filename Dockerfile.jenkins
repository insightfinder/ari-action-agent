# ARI Jenkins agent worker image. No git, no per-language build toolchain
# (go/java/maven) — unlike the on-call agent, this one never clones or
# builds anything: it has no repo of its own to check out, and every real
# action against a target Jenkins goes through that Jenkins's own MCP
# server (https://plugins.jenkins.io/mcp-server/) over HTTP, not a local
# checkout. Node + opencode are still required: opencode is the MCP client
# every jenkins_agent capability shells out to (see
# jenkins_agent/tools/opencode_cli.py).
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Node.js + opencode, pinned to the exact version verified against the
# on-call agent's own integration (see docs/MEMORY.md) — the "mode:
# primary" / stdout-error / --format json behavior this codebase relies
# on was confirmed against 1.18.31 specifically.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g opencode-ai@1.18.31 \
    && OPENCODE_DIR="$(npm root -g)/opencode-ai" \
    && ACTIVE_INODE="$(stat -c %i "$OPENCODE_DIR/bin/opencode.exe")" \
    && for variant in "$OPENCODE_DIR"/node_modules/opencode-linux-*; do \
         [ "$(stat -c %i "$variant/bin/opencode" 2>/dev/null)" = "$ACTIVE_INODE" ] || rm -rf "$variant"; \
       done
# See Dockerfile.oncall for why this loop is needed and why it's safe
# only on an AVX2 build host (GitHub Actions' hosted amd64 runners).

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src
COPY configs ./configs

RUN pip install --no-cache-dir .

ENV PYTHONUNBUFFERED=1
ENV AGENT_KIND=jenkins
# Global npm install puts `opencode` on PATH already; settings.py's
# OPENCODE_BIN default ("opencode") relies on exactly that.

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "api.worker"]
